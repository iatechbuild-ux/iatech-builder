{
  "name": "iatech-builder",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "node --use-system-ca ./node_modules/next/dist/bin/next dev",
    "dev:default-ca": "next dev",
    "build": "next build",
    "start": "next start",
    "start:system-ca": "node --use-system-ca ./node_modules/next/dist/bin/next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "node --use-system-ca ./node_modules/@playwright/test/cli.js test",
    "test:e2e:install": "playwright install chromium",
    "dev:test": "node scripts/start-test-server.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.3.0",
    "@supabase/ssr": "0.12.0",
    "@supabase/supabase-js": "2.110.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.24.0",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "svix": "1.96.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "24.10.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "supabase": "2.109.1",
    "tailwindcss": "4.3.2",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
